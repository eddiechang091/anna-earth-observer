# Build output (uploaded to Anna by the CLI; not committed)
bundle/
dist/

# Dependencies
node_modules/

# Python virtual environments and build artifacts
executas/*/.venv/
executas/*/venv/
executas/**/*.egg-info/
executas/**/dist-*/
executas/**/__pycache__/
executas/**/*.pyc
executas/**/*.pyo

# Environment secrets — never commit
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.suo
.vscode/settings.json

# TypeScript build cache
node_modules/.tmp/

# Test / coverage artefacts
coverage/

# Anna CLI server-side identity — commit this file so the slug stays bound
# .anna/app.json  ← keep tracked

# Temporary QA manifests
manifest.qa-*.json

/__pycache__/*.pyc
