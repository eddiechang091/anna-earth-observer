# Model ID in `provider/model-name` form, forwarded to the proxy as a hint
# (the proxy also reads CLINE_MODEL server-side). `google/gemma-4-31b-it:free`
# is a fast instruct model that needs no account balance. Reasoning models
# (e.g. minimax/minimax-m2.5) also work but burn ~7k tokens thinking, so they
# need VITE_CLINE_MAX_TOKENS >= 8192 to avoid "empty response content".
VITE_CLINE_MODEL=google/gemma-4-31b-it:free

# Inside Anna, CLINE_API_KEY is NOT set here: it is stored as a credential on
# the bundled `earth-data` tool and injected per invoke by the Agent. Enter it
# once in the tool's credential settings in Anna
# (CLINE_MODEL / CLINE_BASE_URL are optional non-sensitive credentials there).
# Everything below applies to local development only.

# Completion budget per AI section. Reasoning models can burn ~7k tokens
# thinking before writing their answer; a small cap makes the API fail with
# 500 "empty response content". Billed usage is only what the model actually
# produced, so a generous cap costs nothing extra.
# VITE_CLINE_MAX_TOKENS=8192